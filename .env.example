# Copy this file to .env and adjust as needed before running docker compose.

# --- Postgres ---
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload
POSTGRES_DB=payload
# Host port to expose Postgres on (dev only; not published in production)
POSTGRES_PORT=5432

# --- App (Next.js / Payload) ---
# Must match the Postgres credentials above; "postgres" is the service
# hostname inside the compose network.
DATABASE_URI=postgres://payload:payload@postgres:5432/payload
# Generate a real secret for anything beyond local dev: openssl rand -base64 32
PAYLOAD_SECRET=change-me
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Host port to expose the app on
APP_PORT=3000
