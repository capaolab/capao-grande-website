# Homologação (staging). Copie para deploy/.env.staging no servidor e ajuste.
# Este arquivo é lido por deploy/compose.yml (variáveis de interpolação) e
# injetado no container (env_file).

# --- Compose ---
# Porta do host onde o app de staging escuta.
APP_PORT=3100
# Rede Docker externa onde está o Postgres compartilhado.
DB_NETWORK=shared-db

# --- App (Next.js / Payload) ---
# "postgres-shared" = nome do container do Postgres na rede DB_NETWORK.
# Usuário por ambiente (capaolab_<ambiente>) e banco da aplicação
# (capaogrande) — ver README, "Preparação do servidor".
DATABASE_URI=postgres://capaolab_staging:TROQUE-A-SENHA@postgres-shared:5432/capaogrande
# Gere com: openssl rand -base64 32 (diferente do de produção)
PAYLOAD_SECRET=
# URL pública do ambiente (usada pelo Payload em links/admin).
NEXT_PUBLIC_SERVER_URL=http://staging.exemplo.local:3100
