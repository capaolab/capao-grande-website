# Produção. Copie para deploy/.env.production no servidor e ajuste.
# Este arquivo é lido por deploy/compose.yml (variáveis de interpolação) e
# injetado no container (env_file).

# --- Compose ---
# Porta do host onde o app de staging escuta.
APP_PORT=3000
# Rede Docker externa onde está o Postgres compartilhado.
DB_NETWORK=shared-db

# --- App (Next.js / Payload) ---
# "postgres-shared" = nome do container do Postgres na rede DB_NETWORK.
# Um banco e um usuário dedicados por aplicação/ambiente.
DATABASE_URI=postgres://capao_production:TROQUE-A-SENHA@postgres-shared:5432/capao_production
# Gere com: openssl rand -base64 32 (diferente do de staging)
PAYLOAD_SECRET=
# URL pública do ambiente (usada pelo Payload em links/admin).
NEXT_PUBLIC_SERVER_URL=https://www.exemplo.com.br
