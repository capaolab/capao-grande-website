{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npx vitest:*)",
      "Bash(npx eslint:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.*.example)",
      "Read(.vercel/**)",
      "Read(*.pem)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(npm run seed:*)",
      "Bash(npm run payload:*)",
      "Bash(npx payload:*)",
      "Bash(docker compose exec app npm run seed:*)",
      "Bash(docker compose exec app npm run payload:*)",
      "Bash(./deploy/deploy.sh:*)",
      "Bash(docker compose down -v:*)"
    ]
  }
}
